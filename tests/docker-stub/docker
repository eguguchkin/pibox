#!/usr/bin/env bash
# shellcheck shell=bash
# ============================================================================
# docker-stub — поддельный docker CLI для `tests/smoke.sh --no-docker`.
#
# Эмулирует ровно тот минимум интерфейса docker, который нужен НЕ-docker-ным
# фазам smoke-тестов (0, 1, 3): проверка демона, версия, inspect образа.
# Всё, что требует настоящего демона (build/run/rm), честно падает —
# docker-зависимые фазы в этом режиме пропускаются, а не имитируются.
#
# Используется только через PATH (tests/docker-stub каталогом в начало PATH
# ставит smoke.sh), на хосте с настоящим docker не участвует.
#
# Переменные:
#   PIBOX_STUB_IMAGE  образ, который считается «найденным»
#                     (по умолчанию pibox:latest; smoke.sh выставляет в
#                     значение PIBOX_IMAGE)
# ============================================================================
set -u

STUB_IMAGE="${PIBOX_STUB_IMAGE:-pibox:latest}"
# версия завышена осознанно: тесты проверяют только «>= 20.10»
STUB_VERSION="99.0.0"

cmd="${1:-}"
shift || true

case "$cmd" in
info)
    # «демон отвечает» — успех без вывода
    exit 0
    ;;
version)
    # вызовы идут с --format '{{.Server.Version}}'; печатаем просто версию —
    # cut/regex-потребители её корректно разберут
    printf '%s\n' "$STUB_VERSION"
    exit 0
    ;;
image)
    # docker image inspect NAME [NAME...] — успех, только если образ известен
    sub="${1:-}"
    [ "$sub" = "inspect" ] && shift
    rc=0
    for name in "$@"; do
        case "$name" in
        -*) continue ;;
        esac
        [ "$name" = "$STUB_IMAGE" ] || rc=1
    done
    exit "$rc"
    ;;
container)
    # inspect несуществующего контейнера — как настоящий docker, rc=1
    exit 1
    ;;
build | pull | push | login)
    printf 'docker-stub: "%s" не эмулируется (требуется настоящий демон)\n' "$cmd" >&2
    exit 1
    ;;
run)
    printf 'docker-stub: "docker run" не эмулируется (docker-фазы в --no-docker пропускаются)\n' >&2
    exit 1
    ;;
rm)
    # cleanup-хуки (docker rm -f) — молча успех
    exit 0
    ;;
*)
    printf 'docker-stub: неподдерживаемая команда: %s\n' "${cmd:-<нет аргументов>}" >&2
    exit 1
    ;;
esac
