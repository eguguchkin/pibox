#!/usr/bin/env bash
set -euo pipefail

# Определяем PIBOX_DIR
if [ -n "${PIBOX_DIR:-}" ]; then
    PIBOX_DIR="$PIBOX_DIR"
else
    # Предполагаем, что скрипт находится в $PIBOX_DIR/bin/
    SCRIPT_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    PIBOX_DIR="$(dirname "$SCRIPT_PATH")"
fi

IMAGE_NAME="pibox:latest"
ENV_TEMPLATE="$PIBOX_DIR/env-template"
ENV_DIR="$PIBOX_DIR/env"
MODELS_FILE="$ENV_DIR/models.json"

# Функции
log() { echo -e "\033[1;32m[PIBOX]\033[0m $*"; }
err() { echo -e "\033[1;31m[PIBOX]\033[0m $*" >&2; exit 1; }

# Проверка Docker
check_docker() {
    if ! command -v docker >/dev/null; then
        err "Docker не установлен или не в PATH"
    fi
    if ! docker info >/dev/null 2>&1; then
        err "Docker daemon не запущен или нет прав"
    fi
}

# Проверка, что workspace не пересекается с PIBOX_DIR
check_workspace() {
    local ws="$1"
    local ws_real pibox_real

    ws_real="$(realpath "$ws")"
    pibox_real="$(realpath "$PIBOX_DIR")"

    # workspace не должен быть внутри PIBOX_DIR
    if [[ "$ws_real" == "$pibox_real"/* ]]; then
        err "Рабочая директория не может находиться внутри $PIBOX_DIR"
    fi
    # PIBOX_DIR не должен быть внутри workspace
    if [[ "$pibox_real" == "$ws_real"/* ]]; then
        err "PIBOX_DIR не может находиться внутри рабочей директории"
    fi
}

# Создание окружения из шаблона
create_env() {
    local name="$1"
    local dest="$ENV_DIR/$name"
    if [ -d "$dest" ]; then
        err "Окружение '$name' уже существует"
    fi
    log "Создание окружения '$name' из шаблона..."
    cp -a "$ENV_TEMPLATE/." "$dest/"
    # Копируем models.json, если его нет в окружении
    if [ -f "$MODELS_FILE" ] && [ ! -f "$dest/.pi/agent/models.json" ]; then
        cp "$MODELS_FILE" "$dest/.pi/agent/models.json"
        log "Скопирован models.json в новое окружение"
    fi
    log "Окружение '$name' готово."
}

# Удаление окружения
remove_env() {
    local name="$1"
    if [ "$name" = "default" ]; then
        err "Нельзя удалить окружение default"
    fi
    local dest="$ENV_DIR/$name"
    if [ ! -d "$dest" ]; then
        err "Окружение '$name' не существует"
    fi
    read -p "Вы уверены, что хотите удалить окружение '$name'? [y/N] " confirm
    if [[ "$confirm" =~ ^[Yy]$ ]]; then
        rm -rf "$dest"
        log "Окружение '$name' удалено"
    else
        log "Удаление отменено"
    fi
}

# Сборка образа
build_image() {
    check_docker
    log "Сборка образа $IMAGE_NAME..."
    docker build -t "$IMAGE_NAME" "$PIBOX_DIR"
    log "Образ собран."
}

# Запуск агента
run_agent() {
    local env_name="${1:-default}"
    shift || true  # остальные аргументы передаются в pi

    # Проверяем окружение
    local env_path="$ENV_DIR/$env_name"
    if [ ! -d "$env_path" ]; then
        log "Окружение '$env_name' не найдено, создаем..."
        create_env "$env_name"
    fi

    # Проверяем models.json
    if [ ! -f "$env_path/.pi/agent/models.json" ] && [ -f "$MODELS_FILE" ]; then
        cp "$MODELS_FILE" "$env_path/.pi/agent/models.json"
        log "Скопирован models.json в окружение '$env_name'"
    fi

    # Определяем workspace — текущая директория
    local workspace="$(pwd)"
    check_workspace "$workspace"

    # Проверяем Docker
    check_docker

    # Проверяем наличие образа, при необходимости собираем
    if ! docker image inspect "$IMAGE_NAME" >/dev/null 2>&1; then
        log "Образ $IMAGE_NAME не найден, собираем..."
        build_image
    fi

    # Параметры запуска
    local docker_args=(
        -it
        --rm
        --name "pibox-$env_name"
        --hostname "pibox-$env_name"
        -v "$env_path:/home/pi"
        -v "$workspace:/home/pi/workspace"
        --add-host "host.docker.internal:host-gateway"
        --cap-add=SYS_PTRACE
        --cap-add=NET_RAW
        --cpus=2
        --memory=4g
        -e "HOST_UID=$(id -u)"
        -e "HOST_GID=$(id -g)"
        -e "GIT_SAFE_DIRECTORY=${GIT_SAFE_DIRECTORY:-false}"
    )

    # Проброс переменных окружения для API-ключей (все, начинающиеся с PI_ или OPENAI_)
    while IFS= read -r -d '' var; do
        docker_args+=(-e "$var")
    done < <(env -0 | grep -z '^\(PI_\|OPENAI_\|ANTHROPIC_\)')

    # Проброс портов, если указаны через переменную PIBOX_PORTS (например, "8080:8080 3000:3000")
    if [ -n "${PIBOX_PORTS:-}" ]; then
        for port_map in $PIBOX_PORTS; do
            docker_args+=(-p "$port_map")
        done
    fi

    log "Запуск Pi-агента в окружении '$env_name' (workspace: $workspace)"
    docker run "${docker_args[@]}" "$IMAGE_NAME" pi "$@"
}

# Список окружений
list_envs() {
    if [ ! -d "$ENV_DIR" ]; then
        echo "Директория окружений не найдена."
        return
    fi
    echo "Доступные окружения:"
    for d in "$ENV_DIR"/*/; do
        [ -d "$d" ] || continue
        name="$(basename "$d")"
        if [ -f "$d/.pi/agent/models.json" ]; then
            echo "  $name (с models.json)"
        else
            echo "  $name"
        fi
    done
}

# Помощь
show_help() {
    cat <<EOF
Использование: pibox [команда] [аргументы]

Команды:
  (без команды) [env_name] [args...]   Запустить Pi-агента в окружении env_name (по умолчанию 'default')
  env list                              Показать список окружений
  env create <name>                     Создать новое окружение из шаблона
  env rm <name>                         Удалить окружение
  build                                 Собрать Docker-образ
  help                                  Показать эту справку

Переменные окружения:
  PIBOX_DIR         Директория установки PIBOX (по умолчанию автоопределение)
  PIBOX_PORTS       Проброс портов (например, "8080:8080 3000:3000")
  GIT_SAFE_DIRECTORY=true  Включить git safe.directory для workspace
  PI_API_KEY, OPENAI_API_KEY, ANTHROPIC_API_KEY и т.п. — пробрасываются в контейнер
EOF
}

# Основная логика
main() {
    if [ $# -eq 0 ]; then
        run_agent "default"
        exit 0
    fi

    case "$1" in
        help|-h|--help)
            show_help
            ;;
        build)
            build_image
            ;;
        env)
            shift
            case "${1:-}" in
                list)
                    list_envs
                    ;;
                create)
                    shift
                    if [ -z "${1:-}" ]; then
                        err "Укажите имя окружения"
                    fi
                    create_env "$1"
                    ;;
                rm|remove)
                    shift
                    if [ -z "${1:-}" ]; then
                        err "Укажите имя окружения"
                    fi
                    remove_env "$1"
                    ;;
                *)
                    show_help
                    ;;
            esac
            ;;
        *)
            # Первый аргумент — имя окружения
            run_agent "$@"
            ;;
    esac
}

main "$@"