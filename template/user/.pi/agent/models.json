{
  "providers": {
    "providerID": {
      "name": "Local Model API",
      "baseUrl": "http://host.docker.internal:8080/v1",
      "api": "openai-completions",
      "apiKey": "REPLACE_ME",
      "models": [
        {
          "id": "modelID",
          "name": "Model Name",
          "maxTokens": 4096,
          "contextWindow": 40960,
          "reasoning": true,
          "input": ["text", "image"],
          "compat": {
            "supportsReasoningEffort": true
          },
          "thinkingLevelMap": {
            "minimal": "minimal",
            "low": "low",
            "medium": "medium",
            "high": "high",
            "xhigh": "xhigh",
            "max": "max"
          }
        }
      ]
    },
    "defaultProvider": "providerID",
    "defaultModel": "modelID"
  }
}