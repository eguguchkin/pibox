#!/usr/bin/env bash
# imgfit <файл> [макс-ширина=800] — показать картинку в чате pi-web-ui.
# Превью кладёт в /tmp/imgfit (вне workspace), печатает готовые markdown-строки.
# Зависимости: python3 (в образе) + Pillow (venv, создаётся сам при первом запуске, нужна сеть ~15с).
set -euo pipefail
f=$1; w=${2:-800}
VENV="$HOME/.pi/agent/venv-img"
if [ ! -x "$VENV/bin/python" ]; then
    echo "imgfit: создаю venv с Pillow (однократно, ~15с)..." >&2
    python3 -m venv "$VENV"
    "$VENV/bin/pip" install -q --disable-pip-version-check pillow
fi
exec "$VENV/bin/python" - "$f" "$w" <<'EOF'
import sys, os
from urllib.parse import quote
from PIL import Image
src, mw = sys.argv[1], int(sys.argv[2])
im = Image.open(src)
ow, oh = im.size
osize = os.path.getsize(src)
outdir = '/tmp/imgfit'
os.makedirs(outdir, exist_ok=True)
name = os.path.splitext(os.path.basename(src))[0]
if im.width <= mw:
    out, pw, ph = src, ow, oh
else:
    ph = max(1, round(oh * mw / im.width))
    im.resize((mw, ph), Image.LANCZOS).convert('RGB') \
      .save(os.path.join(outdir, f'{name}-w{mw}.jpg'), quality=88)
    out, pw, ph = os.path.join(outdir, f'{name}-w{mw}.jpg'), mw, ph
hsize = os.path.getsize(out)
hum = lambda n: f'{n/1048576:.1f} МБ' if n >= 1048576 else f'{n/1024:.0f} КБ'
print(f'![{name}](/api/file?path={quote(out)})')
print(f'*оригинал: `{src}` · {ow}×{oh} · {hum(osize)} · превью {pw}×{ph}, {hum(hsize)}*')
EOF
